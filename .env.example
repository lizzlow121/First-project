# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Required for AI-drafted proposals. Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Which Claude model to draft proposals with.
# Options: claude-opus-4-8 (best), claude-sonnet-4-6 (balanced), claude-haiku-4-5 (cheapest)
CLAUDE_MODEL=claude-sonnet-4-6

# Your daily earnings goal in USD.
DAILY_GOAL_USD=10
